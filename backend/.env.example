# Flask secrets — change these in production
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too

# Database: defaults to local SQLite (farmsphere.db) if unset.
# For PostgreSQL: postgresql://user:password@localhost:5432/farmsphere
DATABASE_URL=sqlite:///farmsphere.db

# Optional: enables real generative AI for the Assistant and Crop Health
# (disease detection) features via OpenAI. Without this, both features work
# fully offline using a deterministic rule-based fallback engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173
